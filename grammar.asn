;; Package Grammar & Exported Symbol Registry (ASN)
;; @genseam/agent-bus
(:grammar
  :package @genseam/agent-bus
  :version "0.1.0"
  :tokens-baseline 2
  :symbols [
    ;; Core Types (<= 2 tokens)
    (:sym :name "AgentMessage" :kind :type :tokens 2)
    (:sym :name "BusEvent" :kind :type :tokens 2)
    (:sym :name "TransportProtocol" :kind :type :tokens 2)
    (:sym :name "MeshNode" :kind :type :tokens 2)
    (:sym :name "RoutingTable" :kind :type :tokens 2)

    ;; Core Functions (<= 2 tokens)
    (:sym :name "is-broadcast" :kind :fn :tokens 2)
    (:sym :name "route-packet" :kind :fn :tokens 2)
    (:sym :name "run-tests" :kind :fn :tokens 2)

    ;; Extended Operations (> 2 tokens with required :rationale)
    (:sym :name "format-sse-event" :kind :fn :tokens 3
          :rationale "Formats standard Server-Sent Events stream payload for agent bus clients")
    (:sym :name "create-routing-table" :kind :fn :tokens 3
          :rationale "Initializes empty routing table for the swarm mesh")
    (:sym :name "register-mesh-node" :kind :fn :tokens 3
          :rationale "Registers an active agent node into the mesh routing table")
    (:sym :name "is-node-alive" :kind :fn :tokens 3
          :rationale "Heartbeat and liveness inspection predicate for mesh nodes")

    ;; Phase 09 L7 Cognitive Gateway Symbols
    (:sym :name "GatewayChannel" :kind :type :tokens 1)
    (:sym :name "MultiplexedFrame" :kind :type :tokens 1)
    (:sym :name "GatewayInspectionVerdict" :kind :type :tokens 1)
    (:sym :name "demux-stream-content" :kind :fn :tokens 3
          :rationale "De-multiplexes raw model streams into UI, quarantined reasoning, and tool channels")
    (:sym :name "detect-esh-violation" :kind :fn :tokens 3
          :rationale "Detects verbal execution simulation hallucinations without runtime proof")
    (:sym :name "calculate-lcs-grounding" :kind :fn :tokens 3
          :rationale "Computes character and token grounding ratio against referenced source files")
    (:sym :name "inspect-gateway-turn" :kind :fn :tokens 3
          :rationale "Audits agent turn frame enforcing cognitive isolation and anti-hallucination policies")
    (:sym :name "format-gateway-verdict" :kind :fn :tokens 3
          :rationale "Formats structured diagnostic S-expression verdict from gateway inspection")
    (:sym :name "test-demux-channels" :kind :fn :tokens 3
          :rationale "Unit test verifying tri-channel multiplexing and separation")
    (:sym :name "test-quarantine-reasoning" :kind :fn :tokens 3
          :rationale "Unit test verifying chain-of-thought tokens are quarantined from user output")
    (:sym :name "test-verbal-esh-rejection" :kind :fn :tokens 4
          :rationale "Unit test verifying verbal claims of test passage without proof are rejected")
    (:sym :name "test-verified-execution-allowed" :kind :fn :tokens 4
          :rationale "Unit test asserting verified runtime executions are permitted by the gateway")
    (:sym :name "test-lcs-grounding" :kind :fn :tokens 3
          :rationale "Unit test verifying token overlap grounding calculations")
    (:sym :name "test-format-gateway-verdict" :kind :fn :tokens 4
          :rationale "Unit test asserting structured formatting of gateway diagnostic blocks")
    (:sym :name "adapt-anthropic-request" :kind :fn :tokens 3
          :rationale "Adapts Anthropic Messages requests into canonical ASL gateway frame")
    (:sym :name "format-anthropic-response" :kind :fn :tokens 3
          :rationale "Formats Gateway inspection verdict into valid Anthropic Messages response JSON")
    (:sym :name "test-anthropic-adapter" :kind :fn :tokens 3
          :rationale "Verifies adaptation of Anthropic Messages requests and responses")

    ;; Phase 18 Browser Bridge Symbols
    (:sym :name "BridgeTab" :kind :type :tokens 1)
    (:sym :name "BridgeCommand" :kind :type :tokens 1)
    (:sym :name "BrowserBridgeState" :kind :type :tokens 1)
    (:sym :name "bridge-init" :kind :fn :tokens 2)
    (:sym :name "bridge-register-tab" :kind :fn :tokens 3
          :rationale "Registers or updates active browser tab in the bridge state registry")
    (:sym :name "bridge-enqueue-command" :kind :fn :tokens 3
          :rationale "Appends incoming action command to the bridge queue in FIFO order")
    (:sym :name "bridge-poll-commands" :kind :fn :tokens 3
          :rationale "Pulls pending commands for target tab and transitions status to dispatched")
    (:sym :name "bridge-complete-command" :kind :fn :tokens 3
          :rationale "Marks command completed with execution result or records failure")
    (:sym :name "handle-mcp-request" :kind :fn :tokens 3
          :rationale "Routes incoming JSON-RPC MCP requests across initialize, tools/list, and tools/call")
    (:sym :name "format-cors-http-response" :kind :fn :tokens 4
          :rationale "Constructs HTTP response string with permissive CORS headers and status code")
    (:sym :name "test-bridge-init" :kind :fn :tokens 3
          :rationale "Verifies initialization of bridge state on configured port")
    (:sym :name "test-bridge-register-tab" :kind :fn :tokens 4
          :rationale "Verifies tab registration and metadata update semantics")
    (:sym :name "test-bridge-enqueue-and-poll-fifo" :kind :fn :tokens 6
          :rationale "Verifies FIFO command queuing and atomic dispatch state transition on poll")
    (:sym :name "test-bridge-complete-command" :kind :fn :tokens 4
          :rationale "Verifies command status transition to completed and result storage")
    (:sym :name "test-format-cors-http-response" :kind :fn :tokens 5
          :rationale "Verifies formatting of HTTP responses with permissive CORS headers")
    (:sym :name "test-handle-mcp-request" :kind :fn :tokens 4
          :rationale "Verifies MCP protocol request handling across initialize, list, and call")

    ;; Phase 33 Wire Protocol & Adaptive Compression Symbols
    (:sym :name "CodecKind" :kind :type :tokens 1)
    (:sym :name "CompressionAlgo" :kind :type :tokens 2)
    (:sym :name "WireFrame" :kind :type :tokens 1)
    (:sym :name "is-compressed?" :kind :fn :tokens 2)
    (:sym :name "create-wire-frame" :kind :fn :tokens 3
          :rationale "Constructs an adaptive wire frame routing raw or compressed payloads by length threshold")
    (:sym :name "compact-wire-payload" :kind :fn :tokens 3
          :rationale "Applies dictionary-trained token compaction replacing repetitive S-expression heads")
    (:sym :name "expand-wire-payload" :kind :fn :tokens 3
          :rationale "Inverts dictionary compaction restoring canonical ASN S-expression heads")
    (:sym :name "encode-wire-frame" :kind :fn :tokens 3
          :rationale "Encodes WireFrame into a serialized wire transmission envelope string")
    (:sym :name "decode-wire-frame" :kind :fn :tokens 3
          :rationale "Parses a serialized wire envelope string into a structured WireFrame")
    (:sym :name "unpack-wire-frame" :kind :fn :tokens 3
          :rationale "Unpacks payload by decompressing when compressed flag is true or returning raw")
    (:sym :name "test-wire-small-payload-uncompressed" :kind :fn :tokens 5
          :rationale "Verifies that messages under 128 bytes bypass compression and pass raw")
    (:sym :name "test-wire-large-payload-compressed" :kind :fn :tokens 5
          :rationale "Verifies that payloads >= 128 bytes are compacted with compression flag true")
    (:sym :name "test-wire-payload-roundtrip" :kind :fn :tokens 4
          :rationale "Verifies dictionary compaction and expansion round-trips with zero data loss")
    (:sym :name "test-wire-encode-decode-envelope" :kind :fn :tokens 5
          :rationale "Verifies serialization and deserialization of wire envelopes")
    (:sym :name "test-wire-unpack-direct-vs-decompressed" :kind :fn :tokens 6
          :rationale "Verifies transparent unpacking across both raw and compressed wire frames")
    (:sym :name "run-wire-tests" :kind :fn :tokens 3
          :rationale "Runs complete unit test suite for wire protocol and compression framing")

    ;; Phase 34 Swarm Presence, Negotiation & External Bridge Symbols
    (:sym :name "AgentStatus" :kind :type :tokens 2)
    (:sym :name "SwarmPeer" :kind :type :tokens 2)
    (:sym :name "SwarmRoom" :kind :type :tokens 2)
    (:sym :name "NegotiationKind" :kind :type :tokens 2)
    (:sym :name "NegotiationOffer" :kind :type :tokens 2)
    (:sym :name "ExternalToolCommand" :kind :type :tokens 1)
    (:sym :name "propose-task" :kind :fn :tokens 2)
    (:sym :name "accept-task" :kind :fn :tokens 2)
    (:sym :name "decline-task" :kind :fn :tokens 2)
    (:sym :name "create-swarm-room" :kind :fn :tokens 3
          :rationale "Initializes empty swarm coordination room")
    (:sym :name "join-swarm-room" :kind :fn :tokens 3
          :rationale "Registers or updates peer in swarm room")
    (:sym :name "leave-swarm-room" :kind :fn :tokens 3
          :rationale "Removes peer from swarm room roster")
    (:sym :name "list-room-peers" :kind :fn :tokens 3
          :rationale "Returns active registered peers in room")
    (:sym :name "find-peer-in-room" :kind :fn :tokens 4
          :rationale "Finds registered room peer by unique identifier")
    (:sym :name "format-presence-roster" :kind :fn :tokens 3
          :rationale "Formats markdown table representation of room peers")
    (:sym :name "bridge-connect-external" :kind :fn :tokens 3
          :rationale "Registers external agent into ASL bus presence")
    (:sym :name "format-external-tool-schema" :kind :fn :tokens 4
          :rationale "Renders single JSON schema for external agents")
    (:sym :name "dispatch-external-command" :kind :fn :tokens 3
          :rationale "Dispatches external agent commands on bus")
    (:sym :name "test-room-create-and-join" :kind :fn :tokens 5
          :rationale "Verifies room creation and peer registration")
    (:sym :name "test-room-peer-lookup" :kind :fn :tokens 4
          :rationale "Verifies peer lookup by agent identifier")
    (:sym :name "test-room-leave" :kind :fn :tokens 3
          :rationale "Verifies peer removal on room departure")
    (:sym :name "test-negotiation-handshake-accept" :kind :fn :tokens 4
          :rationale "Verifies task proposal and acceptance handshake")
    (:sym :name "test-negotiation-handshake-decline" :kind :fn :tokens 4
          :rationale "Verifies task proposal rejection with reason")
    (:sym :name "test-format-presence-roster" :kind :fn :tokens 4
          :rationale "Verifies formatting of presence roster table")
    (:sym :name "test-bridge-external-dispatch" :kind :fn :tokens 4
          :rationale "Verifies external tool dispatch and schema")
    (:sym :name "run-presence-tests" :kind :fn :tokens 3
          :rationale "Runs complete unit test suite for presence and bridge")
  ]
)



